; NVT 100 ps, new velocities (gen-seed set per replica by jobs/run_one.sh), weak Al restraints
define                   = -DPOSRES_AL     ; weak Al restraints (itps/AL6.itp), reference em.gro
integrator               = md
dt                       = 0.001
nsteps                   = 100000
nstxout-compressed       = 0
nstenergy                = 1000
nstlog                   = 5000
gen-vel                  = yes
gen-temp                 = 298.15
gen-seed                 = GENSEED
pcoupl                   = no
; --- interactions: identical to the paper tpr (site04_window04_stateA.tpr) ---
cutoff-scheme            = Verlet
nstlist                  = 10
verlet-buffer-tolerance  = 0.005
coulombtype              = PME
rcoulomb                 = 1.0
vdw-type                 = Cut-off
vdw-modifier             = Potential-shift
rvdw                     = 1.0
DispCorr                 = EnerPres
fourierspacing           = 0.16
pme-order                = 4
ewald-rtol               = 1e-5
pbc                      = xyz
constraints              = h-bonds
constraint-algorithm     = lincs
lincs-order              = 4
comm-mode                = Linear
; single coupling group, as in the paper tpr
tcoupl                   = V-rescale
tc-grps                  = System
tau-t                    = 0.1
ref-t                    = 298.15
free-energy              = no
